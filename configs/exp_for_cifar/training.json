{
    "exp_name": "model training",
    "dataset": "cifar100",
    "net": "resnet50",
    "quant_scheme": "uniform8",
    "quant_mode": "symmetric",
    "bias_bit": 32,
    "strip_wise": true,
    "act_percentile": 0.0,
    "act_range_momentum": 0.99,
    "checkpoint_iter": -1,
    "save_path": "/app/checkpoints",
    "fixed_point_quantization": true,
    "lr": 0.0001,
    "momentum": 0.9,
    "weight_decay": 1e-4,
    "batch_size": 128,
    "workers": 4,
    "epochs": 10,
    "print_freq": 10,
    "data": "/data/",
    "data_percentage":0.1,
    "logdir": "/app/log/"
}