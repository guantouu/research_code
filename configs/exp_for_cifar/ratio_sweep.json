{
    "exp_name": "ratio_sweep",
    "net": "resnet20",
    "dataset": "cifar10",
    "batch_size": 128,
    "logdir": "/app/log",
    "print_freq": 1000,
    "saliency_file": "saliency/resnet20_cifar10_quant_perturbation.json",
    "bits": {
        "highly_sensitive": 8,
        "insensitive": 4
    },
    "bias_bit": 32,
    "allocators": [
        "saliency",
        "random"
    ],
    "seed": 0,
    "search": "grid",
    "ratios": [
        0.5,
        0.6,
        0.7,
        0.74,
        0.8,
        0.85,
        0.9,
        0.95,
        1.0
    ],
    "max_acc_drop": 1.0,
    "ratio_tol": 0.01,
    "search_samples": 5000,
    "qat_after_search": false,
    "qat_allocators": [
        "saliency"
    ],
    "finetune_config": "/app/configs/exp_for_cifar/fine_tuning.json",
    "finetune_epochs": 0,
    "lr": 0.001,
    "momentum": 0.9,
    "weight_decay": 0.0001,
    "save_models": false
}
