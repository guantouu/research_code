{
    "exp_name": "iteration model",
    "dataset": "cifar10",
    "net": "vgg11",
    "quant_mode": "symmetric",
    "bias_bit": 32,
    "lr": 0.0006,
    "momentum": 0.9,
    "weight_decay": 1e-4,
    "workers": 4,
    "epochs": 2,
    "print_freq": 100,
    "data": "/data/",
    "data_percentage":0.1,
    "logdir": "/app/log/",
    "batch_size": 128,
    "bits": {
        "highly_sensitive": 8,
        "insensitive": 4
    }
} 